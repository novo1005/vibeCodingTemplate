# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
# Demo (default): sqlite, single file, zero-setup. Tables auto-created on boot.
DB_DIALECT=sqlite
DB_SQLITE_FILE=./data/dev.db

# Production: switch to postgres and run `npm run db:migrate` before `npm start`.
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/vibecoding

# AI Gateway
AI_GATEWAY_BASE_URL=https://ops-ai-gateway.yc345.tv/v1/chat/completions
# AI_GATEWAY_API_KEY=replace-with-company-gateway-token
AI_GATEWAY_MODELS=local
AI_GATEWAY_DEFAULT_MODEL=local
AI_GATEWAY_TIMEOUT_MS=30000
AI_GATEWAY_REPAIR_ATTEMPTS=1
